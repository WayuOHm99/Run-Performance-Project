# ── กุญแจ/ความลับ — ห้ามขึ้น git เด็ดขาด ──
scripts/.env
scripts/.env.*
!scripts/.env.example

# ── ไฟล์ขยะของ Python ──
__pycache__/
*.pyc
# .venv* ไม่ใช่ .venv เฉย ๆ: venv ทิ้งขว้างชื่อ .venv-lock-test (306 MB) เคยรอดสายตา
# ทุกทางอยู่หลายสัปดาห์ เพราะ venv มี .gitignore ของตัวเองข้างใน git เลยไม่เห็น
# และ robocopy ตัดแค่ชื่อ ".venv" เป๊ะ ๆ → มันถูก mirror ขึ้น backup ทุกคืน (16 ส.ค. 69)
garmin/.venv*/

# ── โฟลเดอร์ชั่วคราวของเครื่องมือ/เอเจนต์ (มี venv ของตัวเองอยู่ข้างใน) ──
.tmp/

# ── โมดูล Garmin: token = credential, garmin.db = ข้อมูลสุขภาพ — ห้ามขึ้น git ──
garmin/tokens/
garmin/data/
# ไฟล์ token ที่นักกีฬาส่งกลับมา (เผื่อวางผิดที่)
garmin_token_*.zip
garmin_tokens.json
# Streamlit credentials (config.toml is public UI config; secrets.toml is not)
garmin/.streamlit/secrets.toml

# ── ค่าเฉพาะเครื่องของ Claude Code ──
.claude/settings.local.json

# ── ข้อมูลดิบนักกีฬา (ข้อมูลสุขภาพส่วนบุคคล) ──
# คลัง athletes\ + team_data\ ยุค LINE ถูกลบทิ้งแล้ว 16 ส.ค. 69 แต่กฎนี้ยังอยู่:
# ถ้าวันหลังมีใครวางรูป/ข้อความของนักกีฬาลงมาอีก ต้องไม่หลุดขึ้น git โดยอัตโนมัติ
athletes/
team_data/
แดน/
น้องต้อง/
พี่เก้า/
พี่มิลค์/
_โค้ช/
_ทีม/
