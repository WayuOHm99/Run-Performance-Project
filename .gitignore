# ── กุญแจ/ความลับ — ห้ามขึ้น git เด็ดขาด ──
scripts/.env
scripts/.env.*
!scripts/.env.example

# ── ไฟล์ขยะของ Python ──
__pycache__/
*.pyc
garmin/.venv/

# ── โมดูล Garmin: token = credential, garmin.db = ข้อมูลสุขภาพ — ห้ามขึ้น git ──
garmin/tokens/
garmin/data/
# ไฟล์ token ที่นักกีฬาส่งกลับมา (เผื่อวางผิดที่)
garmin_token_*.zip
garmin_tokens.json

# ── ค่าเฉพาะเครื่องของ Claude Code ──
.claude/settings.local.json

# ── ข้อมูลดิบนักกีฬา (ข้อมูลสุขภาพส่วนบุคคล) ──
# เก็บนอก git โดยตั้งใจ เพื่อให้อนาคต push โค้ด/เอกสารขึ้น GitHub ได้
# โดยไม่มีข้อมูลส่วนบุคคลติดไป — รูปดิบสำรองด้วยระบบ backup แยกต่างหาก
แดน/
น้องต้อง/
พี่เก้า/
พี่มิลค์/
_โค้ช/
_ทีม/
