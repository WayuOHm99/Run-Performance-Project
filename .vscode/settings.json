{
  "claudeCode.initialPermissionMode": "plan",
  "explorer.confirmDelete": false,
  "files.eol": "\n",
  "[powershell]": {
    "files.encoding": "utf8bom",
    "files.eol": "\r\n"
  },
  "[bat]": {
    "files.eol": "\r\n"
  },
  "[vb]": {
    "files.eol": "\r\n"
  },
  "files.exclude": {
    "**/__pycache__": true
  },
  "files.watcherExclude": {
    "**/__pycache__/**": true,
    "garmin/.venv/**": true,
    "garmin/data/**": true,
    "garmin/tokens/**": true
  },
  "git.confirmSync": true,
  "git.enableSmartCommit": false,
  "python.defaultInterpreterPath": "${workspaceFolder}/garmin/.venv/Scripts/python.exe",
  "search.exclude": {
    "**/__pycache__": true,
    "garmin/.venv": true,
    "garmin/data/**": true,
    "garmin/tokens/**": true
  }
}
