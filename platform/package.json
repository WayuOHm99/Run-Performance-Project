{
  "name": "run-performance-platform",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "corepack pnpm --filter @run-performance/mobile lint",
    "typecheck": "corepack pnpm --filter @run-performance/mobile typecheck",
    "test": "corepack pnpm --filter @run-performance/mobile test",
    "test:tooling": "node --test \"tooling/local-demo/*.test.mjs\"",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "demo:reset": "node tooling/local-demo/demo-reset.mjs",
    "demo:web": "node tooling/local-demo/demo-web.mjs",
    "demo:android": "node tooling/local-demo/demo-android.mjs",
    "demo:stop": "node tooling/local-demo/demo-stop.mjs",
    "demo:verify": "node tooling/local-demo/demo-verify.mjs",
    "demo:verify:consent": "node tooling/local-demo/demo-verify-consent.mjs"
  },
  "prettier": {
    "endOfLine": "auto"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "supabase": "2.109.1"
  }
}
