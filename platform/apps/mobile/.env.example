# Hosted project. Copy this file to .env.local and replace only the
# publishable-key placeholder. See docs/app/SUPABASE-ENVIRONMENT.md.
#
# Every EXPO_PUBLIC_ value is inlined into the client bundle and is readable by
# end users. Never put a secret key, a legacy service-role key, a database
# password, a personal access token, or a signing key here.
EXPO_PUBLIC_SUPABASE_URL=https://altlphxckxsudnuwhqfw.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-current-publishable-key

# Optional. Absent or empty means hosted. Any value other than `hosted` or
# `local` is rejected rather than treated as hosted.
#
# You do not need to set this for the local demo: `corepack pnpm demo:web` and
# `corepack pnpm demo:android` set it, the URL, and the local publishable key as
# process-scoped variables, and set EXPO_NO_DOTENV=1 so this file and .env.local
# are not read at all. See docs/app/LOCAL-DEMO.md.
# EXPO_PUBLIC_SUPABASE_ENVIRONMENT=hosted
